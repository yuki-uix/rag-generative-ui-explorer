{
  "name": "@rgux/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "evidence:build": "tsx scripts/generate-evidence.ts",
    "bundle:check": "tsx scripts/check-bundle.ts",
    "format": "oxfmt",
    "deploy:check": "pnpm build && wrangler deploy --dry-run --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@rgux/contracts": "workspace:*",
    "@rgux/generation": "workspace:*",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@rgux/corpus": "workspace:*",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "jsdom": "^30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  }
}
