{
  "name": "rag-generative-ui-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "schemas:build": "pnpm --filter @rgux/contracts run schemas:build",
    "schemas:check": "pnpm --filter @rgux/contracts run schemas:check",
    "corpus:validate": "pnpm --filter @rgux/corpus run corpus:validate",
    "corpus:build": "pnpm --filter @rgux/corpus run corpus:build",
    "corpus:check-links": "pnpm --filter @rgux/corpus run corpus:check-links",
    "corpus:chunks": "pnpm --filter @rgux/corpus run corpus:chunks",
    "corpus:ingest": "pnpm --filter @rgux/corpus run corpus:ingest",
    "eval:validate": "pnpm --filter @rgux/corpus run eval:validate",
    "eval:build": "pnpm --filter @rgux/corpus run eval:build",
    "eval:check": "pnpm --filter @rgux/corpus run eval:check",
    "retriever:search": "pnpm --filter @rgux/corpus run retriever:search",
    "web:build": "pnpm --filter @rgux/web run build",
    "web:dev": "pnpm --filter @rgux/web run dev",
    "web:lint": "pnpm --filter @rgux/web run lint",
    "web:evidence:build": "pnpm --filter @rgux/web run evidence:build",
    "web:bundle:check": "pnpm --filter @rgux/web run bundle:check",
    "workspace:check": "node scripts/check-workspace-coverage.mjs",
    "web:deploy": "pnpm --filter @rgux/web run deploy",
    "web:deploy:check": "pnpm --filter @rgux/web run deploy:check",
    "answer:ask": "pnpm --filter @rgux/generation run answer:ask",
    "answer:check": "pnpm --filter @rgux/generation run answer:ask --dry-run",
    "metrics:run": "pnpm --filter @rgux/generation run metrics:run",
    "corpus:embed": "pnpm --filter @rgux/corpus run corpus:embed",
    "metrics:arms": "pnpm --filter @rgux/generation run metrics:arms",
    "corpus:bundle": "pnpm --filter @rgux/corpus run corpus:bundle",
    "web:secret": "pnpm --filter @rgux/web run secret",
    "web:secret:list": "pnpm --filter @rgux/web run secret:list",
    "plan:run": "pnpm --filter @rgux/generation run plan:run",
    "plan:check": "pnpm --filter @rgux/generation run plan:run --dry-run",
    "framework:smoke": "pnpm --filter @rgux/generation run framework:run",
    "framework:live": "pnpm --filter @rgux/generation run framework:run --live",
    "framework:compare": "pnpm --filter @rgux/generation run framework:run --config eval/framework/comparison.json",
    "framework:graph": "pnpm --filter @rgux/generation run framework:run --config eval/framework/graph.json",
    "images:replay": "pnpm --filter @rgux/corpus run images:replay",
    "images:budget": "pnpm --filter @rgux/corpus run images:budget",
    "images:review": "pnpm --filter @rgux/corpus run images:review",
    "web:images:build": "pnpm --filter @rgux/web run images:build",
    "web:images:check": "pnpm --filter @rgux/web run images:check",
    "web:review:dev": "pnpm --filter @rgux/web run review:dev",
    "web:review:build": "pnpm --filter @rgux/web run review:build",
    "web:planner-schema:build": "pnpm --filter @rgux/web run planner-schema:build",
    "web:planner-schema:check": "pnpm --filter @rgux/web run planner-schema:check"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.7.0"
}
