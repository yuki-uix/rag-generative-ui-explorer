{
  "name": "rag-generative-ui-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "schemas:build": "pnpm --filter @rgux/contracts schemas:build",
    "schemas:check": "pnpm --filter @rgux/contracts schemas:check",
    "corpus:validate": "pnpm --filter @rgux/corpus corpus:validate",
    "corpus:build": "pnpm --filter @rgux/corpus corpus:build",
    "corpus:check-links": "pnpm --filter @rgux/corpus corpus:check-links",
    "corpus:chunks": "pnpm --filter @rgux/corpus corpus:chunks",
    "corpus:ingest": "pnpm --filter @rgux/corpus corpus:ingest",
    "eval:validate": "pnpm --filter @rgux/corpus eval:validate",
    "eval:build": "pnpm --filter @rgux/corpus eval:build",
    "eval:check": "pnpm --filter @rgux/corpus eval:check",
    "retriever:search": "pnpm --filter @rgux/corpus retriever:search",
    "web:build": "pnpm --filter @rgux/web build",
    "web:dev": "pnpm --filter @rgux/web dev",
    "web:lint": "pnpm --filter @rgux/web lint",
    "web:evidence:build": "pnpm --filter @rgux/web evidence:build",
    "web:bundle:check": "pnpm --filter @rgux/web bundle:check",
    "workspace:check": "node scripts/check-workspace-coverage.mjs",
    "web:deploy": "pnpm --filter @rgux/web deploy",
    "web:deploy:check": "pnpm --filter @rgux/web deploy:check",
    "answer:ask": "pnpm --filter @rgux/generation answer:ask",
    "answer:check": "pnpm --filter @rgux/generation answer:ask --dry-run",
    "metrics:run": "pnpm --filter @rgux/generation metrics:run",
    "corpus:embed": "pnpm --filter @rgux/corpus corpus:embed",
    "metrics:arms": "pnpm --filter @rgux/generation metrics:arms"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.7.0"
}
